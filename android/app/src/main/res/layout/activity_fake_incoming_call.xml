<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/incomingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fake_call_incoming_bg"
    android:padding="24dp">

    <TextView
        android:id="@+id/incomingCallerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="140dp"
        android:text="Maria Smith"
        android:textColor="#E6EBDD"
        android:textSize="22sp"
        android:textStyle="normal" />

    <TextView
        android:id="@+id/incomingCallerNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/incomingCallerName"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="18dp"
        android:text="+91 9999999999"
        android:textColor="#95A98F"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/incomingMessagePill"
        android:layout_width="168dp"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="240dp"
        android:background="@drawable/fake_call_message_pill_bg"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:src="@android:drawable/sym_action_chat"
            android:tint="#B8C8A0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Message"
            android:textColor="#E4EBDA"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/incomingBottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="64dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/incomingDecline"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/fake_call_end_bg"
                android:contentDescription="Decline"
                android:padding="22dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Decline"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/incomingAccept"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/fake_call_answer_bg"
                android:contentDescription="Answer"
                android:padding="22dp"
                android:src="@android:drawable/ic_menu_call"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/incomingAnswer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Answer"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
