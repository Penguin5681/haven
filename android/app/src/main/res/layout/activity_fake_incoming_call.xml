<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/incomingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fake_call_incoming_bg"
    android:padding="24dp">

    <TextView
        android:id="@+id/incomingCallerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="140dp"
        android:text="Maria Smith"
        android:textColor="#E6EBDD"
        android:textSize="22sp"
        android:textStyle="normal" />

    <TextView
        android:id="@+id/incomingCallerNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/incomingCallerName"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="18dp"
        android:text="+91 9999999999"
        android:textColor="#95A98F"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/incomingMessagePill"
        android:layout_width="168dp"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="240dp"
        android:background="@drawable/fake_call_message_pill_bg"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:src="@android:drawable/sym_action_chat"
            android:tint="#B8C8A0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Message"
            android:textColor="#E4EBDA"
            android:textSize="14sp" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/incomingBottomActions"
        android:layout_width="match_parent"
        android:layout_height="138dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="54dp"
        android:background="@drawable/fake_call_slider_panel_bg"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <TextView
            android:id="@+id/incomingDecline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:focusable="true"
            android:text="Decline"
            android:textColor="#D5887D"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/incomingAccept"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_centerInParent="true"
            android:background="@drawable/fake_call_center_answer_bg"
            android:contentDescription="Accept"
            android:padding="28dp"
            android:src="@android:drawable/sym_action_call"
            android:tint="#52A464" />

        <TextView
            android:id="@+id/incomingAnswer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:focusable="true"
            android:text="Answer"
            android:textColor="#7FAF86"
            android:textSize="14sp" />

    </RelativeLayout>

</RelativeLayout>
